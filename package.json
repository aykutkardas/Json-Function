{
  "name": "json-function",
  "version": "2.0.0",
  "description": "It allows you to use methods such as where, limit, select, orderBy on JSON data.",
  "type": "module",
  "main": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "default": "./dist/package/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "bench": "pnpm build && node bench/run.js"
  },
  "author": "Aykut Kardaş",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/json-function.git"
  },
  "keywords": [
    "json",
    "parse",
    "filter",
    "array",
    "query"
  ],
  "bugs": {
    "url": "https://github.com/aykutkardas/json-function/issues"
  },
  "homepage": "https://github.com/aykutkardas/json-function#readme"
}
