{
  "name": "json-function",
  "version": "1.8.39",
  "description": "It allows you to use methods such as where, limit, select, orderBy on JSON data.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "author": "Aykut Kardaş",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutkardas/json-function.git"
  },
  "keywords": [
    "json",
    "parse",
    "filter",
    "array",
    "query"
  ],
  "bugs": {
    "url": "https://github.com/aykutkardas/json-function/issues"
  },
  "homepage": "https://github.com/aykutkardas/json-function#readme"
}
